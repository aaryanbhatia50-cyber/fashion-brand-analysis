table sales
	lineageTag: 5402b9d6-baff-4cc8-b55b-38c765879207

	measure 'Total Sales' = SUM ( sales[net_sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e19e6735-00a5-4fb0-a1ec-59c0d3d37803

	measure 'Total Profit' = SUM ( sales[profit] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 883e08ef-47f1-4cef-98a5-1b58ad63c501

	measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ec4d98b1-8e5c-4661-a732-e3884a91bf95

	measure 'Total Orders' = DISTINCTCOUNT ( sales[order_id] )
		formatString: #,0
		lineageTag: ce911c3b-d4bd-4b98-923e-6d5704b1f80d

	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1fa843f1-c052-479f-8f68-58639a43a3cd

	measure 'Units Sold' = SUM ( sales[quantity] )
		formatString: #,0
		lineageTag: 43845a2a-6930-459b-bf7e-aea2d4a5490c

	measure 'Active Customers' = DISTINCTCOUNT ( sales[customer_id] )
		formatString: #,0
		lineageTag: 609ee3da-27f7-45d7-b052-912a7450beca

	measure 'Avg Discount %' = AVERAGE ( sales[discount_pct] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8e553e2a-4683-413d-8f1f-c00ace34784f

	measure 'Returned Items' = CALCULATE ( COUNTROWS ( sales ), sales[returned] = "Yes" )
		formatString: #,0
		lineageTag: ea73b490-5caf-44b7-b9e9-2e6dfd51d8b8

	measure 'Return Rate %' = DIVIDE ( [Returned Items], COUNTROWS ( sales ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4d2ed7b6-497b-4e3e-b250-4640713ca7a6

	measure 'Returned Sales' = CALCULATE ( [Total Sales], sales[returned] = "Yes" )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 2751f460-5aa4-4431-a551-5cf59f58c729

	measure 'Orders per Customer' = DIVIDE ( [Total Orders], [Active Customers] )
		formatString: #,0.00
		lineageTag: a7af4592-bddf-4fa2-80de-6a3a3fb8013b

	measure 'Sales MoM %' =
			VAR PrevMonth = CALCULATE ( [Total Sales], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
			RETURN DIVIDE ( [Total Sales] - PrevMonth, PrevMonth )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1bf49dfe-e168-48c7-a8af-a89cf3397daf

	measure 'Top 10 Product Sales' =
			VAR r = RANKX ( ALLSELECTED ( products[product_name] ), [Total Sales] )
			RETURN IF ( ISINSCOPE ( products[product_name] ) && r <= 10, [Total Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9216d044-01dd-481f-b1aa-4284daf96717

