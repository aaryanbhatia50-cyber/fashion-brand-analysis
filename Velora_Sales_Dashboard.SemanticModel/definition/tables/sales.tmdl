	partition sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"order_line_id", Int64.Type}, {"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"channel", type text}, {"size", type text}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"discount_pct", type number}, {"gross_sales", Currency.Type}, {"net_sales", Currency.Type}, {"cost", Currency.Type}, {"profit", Currency.Type}, {"returned", type text}, {"return_reason", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

