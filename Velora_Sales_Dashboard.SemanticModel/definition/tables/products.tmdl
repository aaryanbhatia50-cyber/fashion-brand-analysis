	partition products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"product_id", type text}, {"product_name", type text}, {"category", type text}, {"sub_category", type text}, {"collection", type text}, {"color", type text}, {"list_price", Currency.Type}, {"unit_cost", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

